# PostgreSQL started by docker compose (see docker-compose.yml). For production use your own server and a strong password.
DATABASE_URL="postgresql://leavedesk:leavedesk@localhost:5432/leavedesk?schema=public"
AUTH_SECRET="replace-with-a-long-random-string"
CRON_SECRET="replace-with-another-long-random-string"
APP_URL="http://localhost:3000"
# RESEND_API_KEY=""   (enables real emails)
# MAIL_FROM="LeaveDesk <leave@yourfirm.co.ke>"
# Google sign-in (optional). See the README.
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# Production (Vercel or your server): set these as environment variables, never commit them.
# DATABASE_URL  = your managed PostgreSQL connection string (often ends in ?sslmode=require)
# AUTH_SECRET   = a long random string, e.g. from: openssl rand -hex 32
# CRON_SECRET   = another long random string
# APP_URL       = https://your-domain (no trailing slash)
# RESEND_API_KEY and MAIL_FROM are REQUIRED in production: sign-up confirmation and password reset are sent by email.
