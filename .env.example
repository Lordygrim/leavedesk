# PostgreSQL started by docker compose (see docker-compose.yml). For production use your own server and a strong password.
DATABASE_URL="postgresql://leavedesk:leavedesk@localhost:5432/leavedesk?schema=public"
AUTH_SECRET="replace-with-a-long-random-string"
CRON_SECRET="replace-with-another-long-random-string"
APP_URL="http://localhost:3000"
