generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// One row per organization (law firm, school, company...). Everything else belongs to one organization.
model Organization {
  id         String      @id @default(cuid())
  name       String
  q1Days     Int         @default(6) // annual leave days people may take Jan to Mar
  q2Days     Int         @default(5) // Apr to Jun
  q3Days     Int         @default(5) // Jul to Sep
  q4Days     Int         @default(5) // Oct to Dec
  createdAt  DateTime    @default(now())
  users      User[]
  roles      Role[]
  leaveTypes LeaveType[]
  holidays   Holiday[]
  closures   Closure[]
  audits     AuditLog[]
}

model User {
  id            String         @id @default(cuid())
  orgId         String
  org           Organization   @relation(fields: [orgId], references: [id])
  name          String
  email         String         @unique
  passwordHash  String
  roleId        String
  role          Role           @relation(fields: [roleId], references: [id])
  department    String
  active        Boolean        @default(true)
  googleId      String?        @unique        // set when the person signs in with Google
  hasPassword   Boolean        @default(true) // false for people who only ever sign in with Google
  isOwner       Boolean        @default(false) // created the organization; always an admin
  isAdmin       Boolean        @default(false) // admin access granted by the owner or another admin
  managerId     String?                       // who approves this person's leave (a supervising partner or manager)
  manager       User?          @relation("Reports", fields: [managerId], references: [id])
  reports       User[]         @relation("Reports")
  requests      LeaveRequest[]
  notifications Notification[]
  resets        PasswordReset[]
}

// One row per "forgot password" email. Only a hash of the token is stored; each link works once and expires.
model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
}

// Job titles for one organization. A role whose name is HR (or Human Resources) gives its people admin access automatically.
model Role {
  id          String       @id @default(cuid())
  orgId       String
  org         Organization @relation(fields: [orgId], references: [id])
  name        String
  grantsAdmin Boolean      @default(false)
  users       User[]

  @@unique([orgId, name])
}

model LeaveType {
  id          String         @id @default(cuid())
  orgId       String
  org         Organization   @relation(fields: [orgId], references: [id])
  name        String
  daysPerYear Int
  quarterly   Boolean        @default(false) // true: days come from the organization's quarterly allowances
  requests    LeaveRequest[]

  @@unique([orgId, name])
}

model LeaveRequest {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id])
  typeId           String
  type             LeaveType @relation(fields: [typeId], references: [id])
  startDate        String    // YYYY-MM-DD, date-only on purpose
  endDate          String
  workingDays      Int
  reportBackDate   String
  status           String    @default("PENDING") // PENDING, APPROVED, DECLINED, CANCELLED
  note             String?
  decisionReason   String?
  decidedBy        String?
  decidedAt        DateTime?
  actualReturnDate String?
  createdAt        DateTime  @default(now())
}

model Holiday {
  id    String       @id @default(cuid())
  orgId String
  org   Organization @relation(fields: [orgId], references: [id])
  date  String
  name  String

  @@unique([orgId, date])
}

// Mandatory leave or office closure that repeats every year, e.g. 22 Dec to 11 Jan. Stored as MM-DD.
model Closure {
  id      String       @id @default(cuid())
  orgId   String
  org     Organization @relation(fields: [orgId], references: [id])
  name    String
  startMd String
  endMd   String
}

// A person who has started signing up but has not created their organization yet.
// Email sign-ups wait here until the emailed link is clicked; Google sign-ups are confirmed straight away.
model PendingAccount {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String?   // email sign-ups only
  googleId     String?   // Google sign-ups only
  name         String?
  tokenHash    String?   @unique // hash of the emailed confirmation link
  confirmedAt  DateTime?
  createdAt    DateTime  @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  title     String
  body      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String       @id @default(cuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id])
  actor     String
  action    String
  detail    String
  createdAt DateTime     @default(now())
}
